# Hermes Agent environment variables
# These are set via systemd Environment= lines in rkllm-hermes.service
# Do NOT commit a .env file with real values — use the service unit instead

# Gateway API key — clients (OpenWebUI) use this to authenticate to port 8642
# Generate: openssl rand -hex 32
HERMES_API_KEY=change-me-use-openssl-rand-hex-32

# OpenRouter — free Nemotron 550B (primary)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — free llama-3.3-70b (fallback when Nemotron hits daily quota)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
