# Hermes Agent environment variables
# Copy to hermes/.env and fill in values — never commit hermes/.env to git

# API key for the Hermes gateway (used by OpenWebUI to connect on port 8642)
# Generate a strong random key: openssl rand -hex 32
HERMES_API_KEY=change-me-use-openssl-rand-hex-32

# Optional: Telegram bot token (get from @BotFather)
# TELEGRAM_BOT_TOKEN=

# Optional: Discord bot token
# DISCORD_BOT_TOKEN=
